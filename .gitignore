# .gitignore

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Node / JavaScript
node_modules/
.npm/
.pnpm-store/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build and temp artifacts
dist/
build/
coverage/
.cache/
.parcel-cache/
*.log
*.tmp
*.temp
*.bak

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Environment files
.env
.env.*

# ZIP / archive outputs
*.zip
*.tar
*.gz

# Browser extension artifacts
*.crx
*.pem

# Misc
*.local
